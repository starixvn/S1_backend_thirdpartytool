{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/tptool/tool-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true
        }
      },
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "ExcludesMessage": [
    "/health",
    "{HostingRequestStartingLog:l}",
    "Executing endpoint '{EndpointName}'",
    "Route matched with {RouteData}.",
    "Executing ObjectResult, writing value of type '{Type}'",
    "Executed action {ActionName}",
    "Executed endpoint '{EndpointName}'",
    "{HostingRequestFinishedLog:l}",
    "Executing ContentResult with HTTP Response ContentType of {ContentType}"
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "SupportTpIds": [ 1, 25, 27, 41 ],
  "SupportSiteIds": [ 1, 2, 3 ],
  "BatchCount": 200,
  "MaxDegreeOfParallelism": 2,
  //"FilePath": "", //local,
  "FilePath": "/tptool/switchtool/", //prod
  //"ConfigService": "http://configservice.nova88dev.com/Local", // local
  "ConfigService": "https://configservice.ailab88.net/" // prod
}
